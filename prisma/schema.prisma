// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ========== NextAuth Models ==========

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ========== Application Models ==========

// 角色權限
// USER: 僅供檢視
// VICE_LEADER: 副組長 - 新增報帳單、查看組內資金
// LEADER: 組長 - 審核組內報帳單
// FINANCE: 財務審核
// ADMIN: 系統管理員
enum Role {
  USER
  VICE_LEADER
  LEADER
  FINANCE
  ADMIN
}

// 通知頻率
enum NotificationFrequency {
  INSTANT       // 即時通知
  DAILY_DIGEST  // 每日摘要
  OFF           // 關閉
}

model User {
  id                    String                 @id @default(cuid())
  name                  String?
  email                 String?                @unique
  emailVerified         DateTime?
  image                 String?                @db.Text  // 改為 Text 以儲存 Base64 頭像
  password              String?                // Hashed password for credentials auth
  role                  Role                   @default(USER)
  department            TeamDepartment?        // 所屬組別
  notificationFrequency NotificationFrequency  @default(INSTANT)  // 通知頻率
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  accounts        Account[]
  sessions        Session[]
  expenseReports  ExpenseReport[]
  approvalActions ApprovalAction[]
  auditLogs       AuditLog[]
  bankAccounts    BankAccount[]    // 收款帳戶
}

// 團隊組別
enum TeamDepartment {
  ELECTRICAL      // 電資組
  MECHANICAL      // 機構組
  DOCUMENTATION   // 文書組
  PR              // 公關組
  FINANCE         // 財管組
  DESIGN          // 意象組
  MENTOR          // 老師/導師
}

enum ReportStatus {
  DRAFT
  PENDING_MANAGER
  PENDING_FINANCE
  RETURNED        // 退回修改
  PAID
  REJECTED
}

model ExpenseReport {
  id             String         @id @default(cuid())
  title          String
  description    String         @default("")
  department     TeamDepartment @default(ELECTRICAL) // 組別
  status         ReportStatus   @default(DRAFT)
  totalAmount    Float          @default(0)
  amountCents    Int
  submitterName  String         @default("Unknown") // 提交者名稱
  submitterEmail String         @default("")        // 提交者 Email
  submitterId    String?        // 可選的外鍵，用於向後相容
  submitter      User?          @relation(fields: [submitterId], references: [id])
  bankAccountId  String?        // 收款帳戶
  bankAccount    BankAccount?   @relation(fields: [bankAccountId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  items           ExpenseItem[]
  approvalActions ApprovalAction[]

  // 索引優化
  @@index([submitterId])           // 查詢使用者的報帳單
  @@index([submitterEmail])        // 按 Email 查詢
  @@index([status])                // 按狀態篩選
  @@index([department])            // 按組別篩選
  @@index([createdAt(sort: Desc)]) // 時間排序
  @@index([status, createdAt])     // 複合索引：狀態+時間
}

model ExpenseItem {
  id          String        @id @default(cuid())
  date        DateTime
  category    String
  description String
  amount      Float
  amountCents Int
  receiptUrl  String?
  reportId    String
  report      ExpenseReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  
  // 審核記錄
  audit       ReceiptAudit?

  // 索引優化
  @@index([reportId])              // 關聯查詢
  @@index([category])              // 按類別統計
  @@index([date])                  // 按日期篩選
}

// 收據審核記錄
model ReceiptAudit {
  id            String      @id @default(cuid())
  expenseItemId String      @unique
  expenseItem   ExpenseItem @relation(fields: [expenseItemId], references: [id], onDelete: Cascade)
  
  // OCR 擷取結果
  extractedAmount   Int?       // 擷取金額（最小貨幣單位）
  extractedDate     DateTime?  // 擷取日期
  extractedVendor   String?    // 擷取商家
  invoiceNumber     String?    // 發票號碼
  rawText           String?    @db.Text  // OCR 原始文字
  
  // 審核結果
  isValid           Boolean    @default(false)
  matchScore        Int        @default(0)  // 匹配分數 0-100
  issues            Json?      // AuditIssue[]
  confidence        Float      @default(0)
  
  createdAt         DateTime   @default(now())
  
  @@index([invoiceNumber])   // 用於重複發票偵測
}

model ApprovalAction {
  id        String        @id @default(cuid())
  reportId  String
  report    ExpenseReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User          @relation(fields: [actorId], references: [id])
  action    String        // APPROVE, REJECT
  comment   String?
  createdAt DateTime      @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  oldData    Json?
  newData    Json?
  createdAt  DateTime @default(now())
}

// 組別預算
model DepartmentBudget {
  id         String         @id @default(cuid())
  department TeamDepartment @unique  // 每個組別只有一筆預算記錄
  budget     Float          @default(0)  // 該組可用資金
  updatedAt  DateTime       @updatedAt
  updatedBy  String         // 誰更新的
}

// ========== Inventory Management Models ==========

// 零件類別
enum ItemCategory {
  MOTOR        // 馬達
  SENSOR       // 感測器
  PNEUMATIC    // 氣壓
  CONTROLLER   // 控制器
  HARDWARE     // 五金
  RAW_MATERIAL // 原料
  TOOL         // 工具
}

// 異動類型
enum TransactionType {
  PURCHASE_IN      // 採購入庫
  PROJECT_USE      // 專案領用
  DAMAGED          // 損壞報廢
  LOST             // 遺失
  AUDIT_ADJUSTMENT // 盤點調整
}

// 零件基本檔
model InventoryItem {
  id               String        @id @default(cuid())
  name             String        // 品名
  sku              String        @unique // 廠商料號 (例如 "REV-21-1650")
  category         ItemCategory  // 類別
  storageLocation  String        // 儲存位置 (例如 "A櫃-3層")
  currentQuantity  Int           @default(0) // 當前數量
  safetyStockLevel Int           @default(0) // 安全庫存水位
  vendorLink       String?       // 購買連結
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  transactions InventoryTransaction[]
}

// 異動流水帳 (Log 表，追蹤每一次庫存變化)
model InventoryTransaction {
  id               String          @id @default(cuid())
  itemId           String
  item             InventoryItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  changeAmount     Int             // 正數=入庫/歸還，負數=領用/報廢
  transactionType  TransactionType // 異動類型
  relatedProjectId String?         // 關聯專案 (若為 PROJECT_USE)
  performedBy      String          // 操作者名稱
  timestamp        DateTime        @default(now())
}

// ========== Funding Management Models ==========

// 資金類型
enum FundingType {
  SPONSORSHIP    // 贊助
  DONATION       // 捐款
  GRANT          // 補助金
  FUNDRAISING    // 募款活動
  OTHER          // 其他
}

// 資金記錄
model FundingRecord {
  id          String      @id @default(cuid())
  title       String      // 標題 (例如: "XX公司贊助")
  amount      Float       // 金額
  type        FundingType // 資金類型
  source      String?     // 來源 (公司/個人名稱)
  description String?     // 備註
  date        DateTime    @default(now()) // 入帳日期
  recordedBy  String      // 記錄者名稱
  createdAt   DateTime    @default(now())

  @@index([date])
  @@index([type])
}

// ========== Bank Account Models ==========

// 收款帳戶
model BankAccount {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  bankName      String   // 銀行/郵局名稱
  branchName    String?  // 分行名稱（選填）
  accountNumber String   // 帳號
  accountHolder String   // 戶名

  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)   // 軟刪除：false = 停用
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  expenseReports ExpenseReport[]

  @@index([userId])
  @@index([userId, isActive])  // 查詢啟用中的帳戶
}
