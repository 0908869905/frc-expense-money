// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ========== NextAuth Models ==========

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ========== Application Models ==========

enum Role {
  USER
  MANAGER
  FINANCE
  ADMIN
}

model User {
  id             String           @id @default(cuid())
  name           String?
  email          String?          @unique
  emailVerified  DateTime?
  image          String?
  password       String?          // Hashed password for credentials auth
  role           Role             @default(USER)
  organizationId String           @default("frc-6998") // 用戶所屬組織
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  accounts        Account[]
  sessions        Session[]
  expenseReports  ExpenseReport[]
  approvalActions ApprovalAction[]
  auditLogs       AuditLog[]
  notifications   Notification[]

  @@index([organizationId])
}

enum ReportStatus {
  DRAFT
  PENDING_MANAGER
  PENDING_FINANCE
  RETURNED        // 退回修改
  PAID
  REJECTED
}

model ExpenseReport {
  id             String       @id @default(cuid())
  title          String
  description    String       @default("")
  status         ReportStatus @default(DRAFT)
  totalAmount    Float        @default(0)
  amountCents    Int?         @default(0)  // 保留此欄位以相容舊的 Prisma Client
  submitterId    String
  submitter      User         @relation(fields: [submitterId], references: [id])
  organizationId String       @default("frc-6998") // 資料隔離：依組織分開
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items           ExpenseItem[]
  approvalActions ApprovalAction[]

  // 索引優化
  @@index([submitterId])           // 查詢使用者的報帳單
  @@index([status])                // 按狀態篩選
  @@index([createdAt(sort: Desc)]) // 時間排序  
  @@index([status, createdAt])     // 複合索引：狀態+時間
  @@index([organizationId])        // 組織過濾
}

model ExpenseItem {
  id          String        @id @default(cuid())
  date        DateTime
  category    String
  description String
  amount      Float
  receiptUrl  String?
  reportId    String
  report      ExpenseReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())

  // 索引優化
  @@index([reportId])              // 關聯查詢
  @@index([category])              // 按類別統計
  @@index([date])                  // 按日期篩選
}

model ApprovalAction {
  id        String        @id @default(cuid())
  reportId  String
  report    ExpenseReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actorId   String
  actor     User          @relation(fields: [actorId], references: [id])
  action    String        // APPROVE, REJECT
  comment   String?
  createdAt DateTime      @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  oldData    Json?
  newData    Json?
  createdAt  DateTime @default(now())
}

// ========== Inventory Management Models ==========

// 零件類別
enum ItemCategory {
  MOTOR        // 馬達
  SENSOR       // 感測器
  PNEUMATIC    // 氣壓
  CONTROLLER   // 控制器
  HARDWARE     // 五金
  RAW_MATERIAL // 原料
  TOOL         // 工具
}

// 異動類型
enum TransactionType {
  PURCHASE_IN      // 採購入庫
  PROJECT_USE      // 專案領用
  DAMAGED          // 損壞報廢
  LOST             // 遺失
  AUDIT_ADJUSTMENT // 盤點調整
}

// 零件基本檔
model InventoryItem {
  id               String        @id @default(cuid())
  name             String        // 品名
  sku              String        @unique // 廠商料號 (例如 "REV-21-1650")
  category         ItemCategory  // 類別
  storageLocation  String        // 儲存位置 (例如 "A櫃-3層")
  currentQuantity  Int           @default(0) // 當前數量
  safetyStockLevel Int           @default(0) // 安全庫存水位
  vendorLink       String?       // 購買連結
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  transactions InventoryTransaction[]
}

// 異動流水帳 (Log 表，追蹤每一次庫存變化)
model InventoryTransaction {
  id               String          @id @default(cuid())
  itemId           String
  item             InventoryItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  changeAmount     Int             // 正數=入庫/歸還，負數=領用/報廢
  transactionType  TransactionType // 異動類型
  relatedProjectId String?         // 關聯專案 (若為 PROJECT_USE)
  performedBy      String          // 操作者名稱
  timestamp        DateTime        @default(now())
}

// 應用內通知
model Notification {
  id        String   @id @default(cuid())
  userId    String   // 接收者
  title     String   // 通知標題
  message   String   // 通知內容
  type      String   @default("INFO") // INFO, WARNING, SUCCESS, ERROR
  link      String?  // 點擊後跳轉連結
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// Phase 5: 進階功能
// ============================================

// 組織 (多租戶架構基礎)
model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique // URL 友好的識別碼
  description String?
  logoUrl     String?
  currency    String   @default("TWD") // 預設幣別
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  budgets     Budget[]
  members     OrganizationMember[]

  @@index([slug])
}

// 組織成員 (多對多關聯)
model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String       @default("MEMBER") // OWNER, ADMIN, MEMBER
  joinedAt       DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

// 預算管理
model Budget {
  id              String       @id @default(cuid())
  name            String       // 預算名稱 (如: Q1 行銷預算)
  category        String?      // 類別限制 (可選)
  amount          Float        // 預算金額
  spent           Float        @default(0) // 已使用金額
  currency        String       @default("TWD")
  startDate       DateTime     // 生效起始日
  endDate         DateTime     // 生效結束日
  alertThreshold  Float        @default(0.8) // 預警閾值 (0.8 = 80%)
  organizationId  String?
  createdBy       String       // 建立者 ID
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([startDate, endDate])
  @@index([category])
}

// 幣別匯率快取
model ExchangeRate {
  id           String   @id @default(cuid())
  baseCurrency String   // 基準貨幣
  currency     String   // 目標貨幣
  rate         Float    // 匯率
  updatedAt    DateTime @default(now())

  @@unique([baseCurrency, currency])
  @@index([baseCurrency])
}
